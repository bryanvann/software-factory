#!/usr/bin/env bash
# Factory gate pyramid (pre-commit tier).
#
# Fast, deterministic checks that must never let garbage reach a PR.
# Installed by `install.sh --project`, which sets `core.hooksPath .githooks`,
# so this applies to every worktree automatically.

set -uo pipefail

FACTORY_HOOKS="$HOME/.claude/factory/hooks"

# --- 1. Secret scan: ALWAYS, for humans and agents alike. ---
if [[ -x "$FACTORY_HOOKS/secret-scan.sh" ]]; then
  "$FACTORY_HOOKS/secret-scan.sh" || exit 1
fi

# --- 2. Diff-size guard: AGENTS ONLY. ---
# This is a scope-creep tripwire for workers, not a rule for the operator. CLAUDECODE=1
# is set inside Claude Code sessions and unset in a plain terminal, so hand
# commits are never blocked by it.
if [[ "${CLAUDECODE:-0}" == "1" && -x "$FACTORY_HOOKS/diff-size-guard.sh" ]]; then
  "$FACTORY_HOOKS/diff-size-guard.sh" || exit 1
fi

# --- 3. Project gates (typecheck, tests): AGENTS ONLY. ---
# Empty means disabled, which is how this ships. Fill in the project's own
# commands, the same ones listed under "Gates" in AGENTS.md.
#
# Do not enable a gate that `main` cannot currently pass. If the baseline is
# red, turning this on blocks every worker on failures it did not cause. Fix
# the baseline first, record the reason here while it stays off, and track
# the fix as an issue.
TYPECHECK_CMD=""   # e.g. "npx tsc --noEmit"
TEST_CMD=""        # e.g. "npm test --silent"
if [[ "${CLAUDECODE:-0}" == "1" ]]; then
  if [[ -n "$TYPECHECK_CMD" ]]; then
    eval "$TYPECHECK_CMD" || { echo "BLOCKED: typecheck failed" >&2; exit 1; }
  fi
  if [[ -n "$TEST_CMD" ]]; then
    eval "$TEST_CMD" || { echo "BLOCKED: tests failed" >&2; exit 1; }
  fi
fi

exit 0
