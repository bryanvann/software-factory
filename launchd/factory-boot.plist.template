<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Recreates tmux and cold-starts each project's Foreman at login. -->
    <key>Label</key><string>com.__PREFIX__.factory-boot</string>
    <key>ProgramArguments</key>
    <array><string>__HOME__/.claude/factory/boot.sh</string></array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key><string>__HOME__</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><false/>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/factory/boot-launchd.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/factory/boot-launchd.log</string>
</dict>
</plist>
